# ==========================================================
# Шаблон конфигурации. Скопируй в .env и заполни значения.
# .env НИКОГДА не коммитить в git (см. .gitignore).
# ==========================================================


# ----- SaleBot API -----
# Личный кабинет SaleBot → Настройки → API
SALEBOT_API_KEY=


# ----- Telegram: бот рассылок (основной) -----
# Тот же бот, что подключён к SaleBot. Webhook трогать нельзя — его держит SaleBot,
# мы используем только sendMessage напрямую.
TELEGRAM_BROADCAST_BOT_TOKEN=
TELEGRAM_BROADCAST_BOT_USERNAME=

# ----- Дополнительные боты (опционально) -----
# Если в SaleBot-проекте несколько ботов и хочешь рассылать через каждый,
# добавь токен по одному на строку — суффикс после EXTRA_BOT_TOKEN_ = username бота.
# Пример:
# EXTRA_BOT_TOKEN_another_bot=12345:abcdef...
# EXTRA_BOT_TOKEN_third_bot=67890:ghijkl...


# ----- Telegram: бот команд -----
# Отдельный бот, через который админы управляют рассылками.
TELEGRAM_COMMAND_BOT_TOKEN=
TELEGRAM_COMMAND_BOT_USERNAME=


# ----- Доступ к боту команд -----
# Username-ы (без @), кто имеет права. Через запятую.
TELEGRAM_ADMIN_USERNAMES=

# ID рабочего группового чата (отрицательное число).
TELEGRAM_WORK_CHAT_ID=

# Тестовые user_id (через запятую) — куда уходят /preview.
TELEGRAM_TEST_USER_IDS=


# ----- Anthropic (Claude) — опционально, для будущей AI-аналитики -----
ANTHROPIC_API_KEY=


# ----- Webhook от SaleBot -----
# Случайная hex-строка 64 символа: openssl rand -hex 32
WEBHOOK_SECRET=


# ----- Дашборд -----
DASHBOARD_TOKEN=


# ----- VPS -----
VPS_HOST=
VPS_PORT=22
VPS_USER=root
VPS_SSH_KEY=~/.ssh/id_ed25519
VPS_DOMAIN=


# ----- Параметры базы и работы -----
DATABASE_PATH=./data/salebot_local.db
BROADCAST_RATE_LIMIT=30
TIMEZONE=Europe/Moscow
